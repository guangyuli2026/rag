# The CLI reads E:/rag/.env; process environment variables take precedence.
# Offline settings work now. This provider is a test double, not a semantic model.
RAG_EMBEDDING_PROVIDER=offline
RAG_OFFLINE_DIMENSION=128
RAG_OFFLINE_NGRAM_MIN=2
RAG_OFFLINE_NGRAM_MAX=3

# Reserved for a future adapter, selected using the provider's official docs.
# These settings are NOT currently implemented. Never put a real key here.
# RAG_EMBEDDING_MODEL=
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_BASE_URL=
